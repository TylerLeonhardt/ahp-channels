{
  "name": "ahp-channels",
  "version": "0.1.1",
  "description": "Run Claude Code channel plugins against Agent Host Protocol servers.",
  "license": "MIT",
  "keywords": [
    "agent-host-protocol",
    "ahp",
    "channels",
    "claude-code",
    "mcp",
    "open-plugins"
  ],
  "homepage": "https://github.com/TylerLeonhardt/ahp-channels#readme",
  "bugs": {
    "url": "https://github.com/TylerLeonhardt/ahp-channels/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerLeonhardt/ahp-channels.git"
  },
  "type": "module",
  "bin": {
    "ahp-channels": "dist/cli.js",
    "ahp-channels-daemon": "dist/daemonMain.js"
  },
  "files": [
    "dist",
    "vscode-extension/*.vsix",
    "LICENSE",
    "PUBLISHING.md",
    "README.md",
    "ROADMAP.md",
    "SHIPPING.md"
  ],
  "scripts": {
    "prebuild": "node scripts/sync-version.mjs --check",
    "build": "tsc -p tsconfig.json && npm run vscode:bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p vscode-extension/tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "test:vscode": "npm run vscode:bundle && node scripts/smoke-vscode-extension.cjs",
    "test:package": "tsx scripts/package-smoke.ts",
    "e2e:local": "tsx scripts/e2e-local.ts",
    "e2e:daemon": "npm run build && tsx scripts/e2e-daemon-local.ts",
    "e2e:fakechat": "npm run build && tsx scripts/e2e-fakechat.ts",
    "e2e:handoff": "npm run build && tsx scripts/e2e-handoff.ts",
    "e2e:permissions": "npm run build && tsx scripts/e2e-fakechat.ts --permissions",
    "e2e:attachments": "npm run build && tsx scripts/e2e-fakechat.ts --attachments",
    "check": "npm run typecheck && npm test && npm run build && npm run test:vscode",
    "vscode:bundle": "node scripts/build-vscode-extension.mjs",
    "vscode:package": "npm run vscode:bundle && cd vscode-extension && vsce package --no-dependencies",
    "prepack": "npm run build && npm run vscode:package",
    "version": "node scripts/sync-version.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@microsoft/agent-host-protocol": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.0",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.21.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.27.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
